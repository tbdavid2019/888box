Options -Indexes
RewriteEngine On

# ── Pass Authorization header to PHP ─────────────────────────
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# ── robots.txt ────────────────────────────────────────────────
# Serve robots.txt as plain text with 200
<Files "robots.txt">
    ForceType text/plain
    <IfModule mod_headers.c>
        Header set Content-Type "text/plain; charset=utf-8"
        Header set X-Robots-Tag "noindex"
    </IfModule>
</Files>

# ── sitemap.xml → sitemap.php ─────────────────────────────────
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]

# ── llms.txt & llms-full.txt → llms.php & skill.php ────────────
RewriteRule ^llms\.txt$ llms.php [L,QSA]
RewriteRule ^llms-full\.txt$ skill.php [L,QSA]

# ── WebMCP / MCP endpoint: /mcp → mcp.php ─────────────────────
RewriteRule ^mcp$ mcp.php [L,QSA]

# ── Pretty Short Share URLs: /v/{token} & /s/{token} ───────────
RewriteRule ^v/([a-zA-Z0-9_-]+)$ view.php?token=$1 [L,QSA]
RewriteRule ^s/([a-zA-Z0-9_-]+)$ view.php?token=$1 [L,QSA]

# ── .well-known/api-catalog ───────────────────────────────────
# Serve without extension, with correct Content-Type
<Files "api-catalog">
    ForceType application/linkset+json
    <IfModule mod_headers.c>
        Header set Access-Control-Allow-Origin "*"
    </IfModule>
</Files>

# ── .well-known/ JSON files ───────────────────────────────────
<FilesMatch "\.(json)$">
    <IfModule mod_headers.c>
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=3600"
    </IfModule>
</FilesMatch>

# ── Security headers ──────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Protect sensitive files ───────────────────────────────────
<FilesMatch "(?i)\.(env|db|sqlite|sqlite3|log|lock|sh|yml|yaml)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(composer\.json|package\.json|package-lock\.json|Dockerfile|docker-compose\.yml|check_eips\.py)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(migrate|migrate_v3)\.php$">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)\.local\.md$">
    Require all denied
</FilesMatch>
